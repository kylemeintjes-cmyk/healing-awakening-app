{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MysticalOracleCorpusRow",
  "type": "object",
  "required": ["id", "tradition", "topic", "tone", "source", "messages", "tags"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "tradition": {
      "type": "string",
      "enum": ["astrology", "tarot", "hermetic", "kabbalah", "sufi", "taoist", "mixed"]
    },
    "topic": {
      "type": "string",
      "enum": ["gifts", "purpose", "healing", "shadow", "relationships", "general"]
    },
    "tone": {
      "type": "string",
      "enum": ["gentle", "direct", "mystic", "pragmatic"]
    },
    "source": { "type": "string", "minLength": 1 },
    "messages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["system", "user", "assistant"]
          },
          "content": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
